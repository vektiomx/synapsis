  "domains": [
    {
      "key": "artifact-storage",
      "field": "immutable_source",
      "positive": "hardlink",
      "negative": "copy",
      "query": "How should we archive build artifacts?",
      "contract": "Archive must preserve the bytes at archive time. A hard link shares writes with the original inode. It is acceptable when the source remains immutable; otherwise make an independent copy.",
      "history": [
        "We archived an immutable build artifact using a hard link. It retained the expected bytes and saved disk space. This successful attempt was limited to immutable sources.",
        "We archived a mutable artifact using a hard link. A later writer changed the archived bytes too. We replaced it with an independent copy; later source writes no longer changed the archived artifact."
      ]
    },
    {
      "key": "event-workers",
      "field": "operations_commute",
      "positive": "parallel",
      "negative": "ordered",
      "query": "How should we schedule this event stream?",
      "contract": "Concurrent workers may reorder events. Reordering preserves the result only when the operations commute. A stream of commuting independent set additions can use parallel workers; a stream containing multiply and add on one accumulator must preserve input order.",
      "history": [
        "Parallel workers processed independent set additions. The operations commute, and every tested execution order produced the same resulting set.",
        "Parallel workers processed multiply then add on a shared accumulator. Reversed scheduling produced a different result. We moved this noncommuting stream to an ordered worker and recovered the expected result."
      ]
    },
    {
      "key": "unicode-identity",
      "field": "canonical_equivalence_allowed",
      "positive": "normalize-nfc",
      "negative": "preserve-bytes",
      "query": "How should we compare Unicode resource identifiers?",
      "contract": "NFC normalization merges canonically equivalent Unicode strings. This is correct for identifiers whose identity contract allows canonical equivalence. Signed byte-sensitive identifiers must retain exact original bytes; normalization can invalidate the signature.",
      "history": [
        "We normalized canonically equivalent display identifiers to NFC before comparing them. They correctly resolved to the same resource under the identity contract that allows canonical equivalence.",
        "We normalized a signed byte-sensitive identifier to NFC. Signature validation failed because the bytes changed. Preserving original bytes fixed validation; canonical equivalence was not permitted for this endpoint."
      ]
    }
  ],
